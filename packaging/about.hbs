<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Amp GPUI third-party licenses</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 56rem; padding: 0 1rem; }
  pre { background: #f2f4f3; overflow-x: auto; padding: 1rem; white-space: pre-wrap; }
</style>
</head>
<body>
