<p>Amp GPUI is built on the open source crates listed here.</p>
{{#each licenses}}
<h2>{{name}}</h2>
<ul>
  {{#each used_by}}
  <li>{{crate.name}} {{crate.version}}</li>
  {{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
